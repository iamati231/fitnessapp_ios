<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <!-- User-facing app name shown on the Home Screen + Settings → Apps list.
         Decouples the display name from the internal product/target name
         (FitnessApp), so we can rename the brand without renaming Xcode
         targets, bundle IDs, or source dirs. -->
    <key>CFBundleDisplayName</key>
    <string>Deltiq</string>
    <!-- Required by App Store Connect's upload validator (error 90713).
         References the AppIcon set in Assets.xcassets — must match
         ASSETCATALOG_COMPILER_APPICON_NAME from project.yml. -->
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>

    <!-- Localization: app supports German + Turkish in addition to base English. -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>de</string>
        <string>tr</string>
    </array>

    <!-- Live Activities (rest timer Lock Screen / Dynamic Island). -->
    <key>NSSupportsLiveActivities</key>
    <true/>

    <!-- DEL-237: Backups in der Dateien-App sichtbar machen.
         Beide Keys zusammen lassen den Documents-Ordner der App unter
         "Dateien → Auf meinem iPhone → Deltiq" erscheinen. Ohne sie liegen
         die automatischen Backups zwar auf dem Geraet, sind fuer den Nutzer
         aber unerreichbar — und ein Backup, an das man nicht herankommt, ist
         im Ernstfall keins.
         UIFileSharingEnabled allein reicht nicht: erst zusammen mit
         LSSupportsOpeningDocumentsInPlace zeigt die Dateien-App den Ordner
         mit seiner Struktur statt eines flachen iTunes-Sharing-Bereichs.
         Konsequenz: ALLES in Documents wird sichtbar. Deshalb liegt dort
         ausschliesslich der Backups-Ordner; Arbeitsdateien bleiben in
         Application Support bzw. Caches. -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>

    <!-- Export Compliance: false = we use ONLY Apple's built-in encryption
         (HTTPS, HealthKit, SwiftData internals). No custom crypto, no
         bundled libsodium/OpenSSL. Skipping this key forces the user to
         answer the same question manually for every TestFlight build via
         App Store Connect. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- HealthKit usage descriptions. iOS shows these in the permission dialog. -->
    <key>NSHealthShareUsageDescription</key>
    <string>Liest dein Gewicht und Koerperfett aus Apple Health, damit du Werte nicht doppelt eintragen musst.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>Schreibt jede neue Messung zurueck nach Apple Health, damit deine Daten in einer Quelle leben.</string>

    <!-- Custom URL scheme for Live Activity / Widget deep-links. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.atamya.FitnessApp</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>fitnessapp</string>
            </array>
        </dict>
    </array>

    <key>UILaunchScreen</key>
    <dict/>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
</dict>
</plist>
