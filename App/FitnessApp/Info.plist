<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <!-- User-facing app name shown on the Home Screen + Settings → Apps list.
         Decouples the display name from the internal product/target name
         (FitnessApp), so we can rename the brand without renaming Xcode
         targets, bundle IDs, or source dirs. -->
    <key>CFBundleDisplayName</key>
    <string>Deltiq</string>
    <!-- Required by App Store Connect's upload validator (error 90713).
         References the AppIcon set in Assets.xcassets — must match
         ASSETCATALOG_COMPILER_APPICON_NAME from project.yml. -->
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>

    <!-- Localization: app supports German + Turkish in addition to base English. -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>de</string>
        <string>tr</string>
    </array>

    <!-- Live Activities (rest timer + Zeitformate Lock Screen / Dynamic Island). -->
    <key>NSSupportsLiveActivities</key>
    <true/>

    <!-- Zeitformate (AMRAP/EMOM/Auf Zeit/Zirkel) im Hintergrund: Die Signaltoene
         (kurze Piepser vor dem Wechsel, langer Ton beim Wechsel/Ende) muessen bei
         gesperrtem Bildschirm oder in einer anderen App erklingen. Dafuer spielt die
         App waehrend eines Laufs unhoerbares Audio ab (BackgroundAudioKeepAlive), das
         sie am Leben haelt - nur solange ein Signal anstehen kann (AMRAP, EMOM, Auf
         Zeit mit Limit, Zirkel-Pause) und der Nutzer es nicht in den Einstellungen
         ausgeschaltet hat. Audio-Session: .playback mit .mixWithOthers (Musik
         anderer Apps laeuft weiter). -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <!-- DEL-237: Backups in der Dateien-App sichtbar machen.
         Beide Keys zusammen lassen den Documents-Ordner der App unter
         "Dateien → Auf meinem iPhone → Deltiq" erscheinen. Ohne sie liegen
         die automatischen Backups zwar auf dem Geraet, sind fuer den Nutzer
         aber unerreichbar — und ein Backup, an das man nicht herankommt, ist
         im Ernstfall keins.
         UIFileSharingEnabled allein reicht nicht: erst zusammen mit
         LSSupportsOpeningDocumentsInPlace zeigt die Dateien-App den Ordner
         mit seiner Struktur statt eines flachen iTunes-Sharing-Bereichs.
         Konsequenz: ALLES in Documents wird sichtbar. Deshalb liegt dort
         ausschliesslich der Backups-Ordner; Arbeitsdateien bleiben in
         Application Support bzw. Caches. -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>

    <!-- Export Compliance: false = we use ONLY Apple's built-in encryption
         (HTTPS, HealthKit, SwiftData internals). No custom crypto, no
         bundled libsodium/OpenSSL. Skipping this key forces the user to
         answer the same question manually for every TestFlight build via
         App Store Connect. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- HealthKit usage descriptions. iOS shows these in the permission dialog.
         The values here are the English fallback (development language); the
         German and Turkish texts live in InfoPlist.xcstrings next to this
         file. Keep both in sync with what HealthKitService really reads and
         writes (requestAuthorization / requestWorkoutReadAuthorization /
         requestWorkoutWriteAuthorization(includeDistance:)). -->
    <key>NSHealthShareUsageDescription</key>
    <string>Deltiq reads your weight, body fat, lean mass, height, date of birth, sex, resting heart rate and steps from Apple Health, so you don't have to enter values twice and your profile and dashboard stay up to date. Deltiq also reads workouts recorded by other apps – to import them if you turn on workout import, and to avoid duplicates when you export past workouts.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>Deltiq writes your measurements (weight, body fat, lean mass) and your completed workouts to Apple Health: strength training by default, cardio only if you turn it on, and both can be switched off in Settings. Optionally with walking and running distance and for past workouts. That way your data lives in one place.</string>

    <!-- Barcode scan (Ernährungssuche erweitern + Barcode-Scan ergänzen):
         used only while the in-app scanner sheet is open, to read a product
         barcode and look it up on Open Food Facts. No photos/video are
         captured or stored. -->
    <key>NSCameraUsageDescription</key>
    <string>Deltiq uses the camera to scan a product's barcode so it can look up its nutrition facts on Open Food Facts.</string>

    <!-- Custom URL scheme for Live Activity / Widget deep-links. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.atamya.FitnessApp</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>fitnessapp</string>
            </array>
        </dict>
    </array>

    <key>UILaunchScreen</key>
    <dict/>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
</dict>
</plist>
