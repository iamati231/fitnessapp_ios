{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "NSHealthShareUsageDescription": {
      "comment": "Apple-Health-Berechtigungsdialog: Lesezugriff. Muss die tatsaechlich gelesenen Daten nennen (HealthKitService.requestAuthorization, toRead, + requestWorkoutReadAuthorization; der Typ Trainings wird dort und in requestWorkoutWriteAuthorization(includeDistance:) immer zusammen mit dem Schreiben angefragt).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deltiq liest Gewicht, Körperfett, Magermasse, Größe, Geburtsdatum, Geschlecht, Ruhepuls und Schritte aus Apple Health, damit du Werte nicht doppelt eintragen musst und Profil und Dashboard aktuell bleiben. Außerdem liest Deltiq Trainings anderer Apps – zum Import, wenn du den Workout-Import einschaltest, und um beim Export früherer Trainings Doppelte zu vermeiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deltiq reads your weight, body fat, lean mass, height, date of birth, sex, resting heart rate and steps from Apple Health, so you don't have to enter values twice and your profile and dashboard stay up to date. Deltiq also reads workouts recorded by other apps – to import them if you turn on workout import, and to avoid duplicates when you export past workouts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deltiq; hem değerleri iki kez girmek zorunda kalmaman hem de profilinin ve panelinin güncel kalması için Apple Health'ten kilonu, yağ oranını, yağsız kütleni, boyunu, doğum tarihini, cinsiyetini, dinlenme nabzını ve adımlarını okur. Ayrıca diğer uygulamaların antrenmanlarını okur – antrenman içe aktarmayı açarsan içe aktarmak için, geçmiş antrenmanları dışa aktarırken de yinelenenleri önlemek için."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "comment": "Apple-Health-Berechtigungsdialog: Schreibzugriff. Muss die tatsaechlich geschriebenen Daten nennen (HealthKitService.requestAuthorization, toShare, sowie requestWorkoutWriteAuthorization(includeDistance:) fuer die Distanz).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deltiq schreibt deine Messungen (Gewicht, Körperfett, Magermasse) und deine abgeschlossenen Trainings nach Apple Health: Krafttraining standardmäßig, Cardio nur auf Wunsch, beides in den Einstellungen abschaltbar. Auf Wunsch auch mit Geh- und Laufdistanz und für frühere Trainings. So leben deine Daten in einer Quelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deltiq writes your measurements (weight, body fat, lean mass) and your completed workouts to Apple Health: strength training by default, cardio only if you turn it on, and both can be switched off in Settings. Optionally with walking and running distance and for past workouts. That way your data lives in one place."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deltiq; ölçümlerini (kilo, yağ oranı, yağsız kütle) ve tamamlanan antrenmanlarını Apple Health'e yazar: kuvvet antrenmanı varsayılan olarak, kardiyo yalnızca sen açarsan; ikisi de Ayarlar'dan kapatılabilir. İstersen yürüyüş ve koşu mesafesiyle ve geçmiş antrenmanlar için de. Böylece verilerin tek bir yerde durur."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deltiq nutzt die Kamera, um den Barcode eines Produkts zu scannen und dessen Nährwerte über Open Food Facts abzurufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deltiq uses the camera to scan a product's barcode so it can look up its nutrition facts on Open Food Facts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deltiq, bir ürünün barkodunu tarayıp Open Food Facts üzerinden besin değerlerini bulmak için kamerayı kullanır."
          }
        }
      }
    }
  }
}
