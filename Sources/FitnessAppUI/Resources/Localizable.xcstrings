    "settings.privacy.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export all your training and profile data as a ZIP archive of CSV files. Useful for backups, switching devices, or simply having your data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportiere alle deine Trainings- und Profildaten als ZIP-Archiv mit CSV-Dateien. Praktisch für Backups, Gerätewechsel oder einfach um deine Daten in der Hand zu haben."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm antrenman ve profil verilerini CSV dosyalarından oluşan bir ZIP arşivi olarak dışa aktar. Yedekleme, cihaz değişikliği veya verilerine sahip olmak için kullanışlıdır."
          }
        }
      }
    },
    "settings.dataExport.title": {
