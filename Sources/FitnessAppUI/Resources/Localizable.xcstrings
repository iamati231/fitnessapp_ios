    "backups.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du findest die Backups auch in der Dateien-App unter „Auf meinem iPhone → Deltiq → Backups“. Von dort kannst du eine Sicherung nach iCloud Drive ziehen oder auf den Rechner kopieren. Der Ordner ist außerdem im iCloud-Gerätebackup enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also find the backups in the Files app under \"On My iPhone → Deltiq → Backups\". From there you can move one to iCloud Drive or copy it to a computer. The folder is also included in your iCloud device backup."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekleri Dosyalar uygulamasında „iPhone'umda → Deltiq → Backups\" altında da bulabilirsin. Oradan bir yedeği iCloud Drive'a taşıyabilir veya bilgisayara kopyalayabilirsin. Klasör ayrıca iCloud cihaz yedeğine dahildir."
          }
        }
      }
    },
