          "stringUnit": {
            "state": "translated",
            "value": "Sehr intensiv — noch 1-2 saubere Wiederholungen im Tank."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok yoğun — tankta 1-2 temiz tekrar kaldı."
          }
        }
      }
    },
    "rir.tooltip.2_5": {
