    "planEditor.envRestore.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben gespeicherte Original-Übungen aus einem früheren Equipment-Wechsel gefunden. Möchtest du diese wiederherstellen (inkl. der letzten Arbeitsgewichte aus der Historie), statt das aktuelle Setup neu anzupassen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We found saved original exercises from a previous equipment change. Restore them (with the last working weights from history) instead of re-adapting the current setup?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki bir ekipman değişikliğinden orijinal hareketler bulduk. Mevcut kurulumu yeniden uyarlamak yerine bunları (geçmişten son çalışma ağırlıklarıyla) geri yüklemek ister misin?"
          }
        }
      }
