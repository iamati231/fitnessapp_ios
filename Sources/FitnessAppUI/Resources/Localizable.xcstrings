    },
    "settings.dataImport.intro.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a Deltiq export ZIP (created on this or another device) and we'll merge the data into your library. Existing workouts, records, measurements and plans stay untouched; your profile and app settings are taken from the archive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Deltiq-Export-ZIP (auf diesem oder einem anderen Gerät erstellt) und wir spielen die Daten in deine Bibliothek ein. Bestehende Workouts, Rekorde, Messungen und Pläne bleiben unangetastet; Profil und App-Einstellungen werden aus dem Archiv übernommen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Deltiq dışa aktarma ZIP'i seç (bu veya başka bir cihazda oluşturulmuş) ve verileri kütüphanene birleştirelim. Mevcut antrenmanların, rekorların, ölçümlerin ve planların değişmez; profil ve uygulama ayarların arşivden alınır."
          }
        }
      }
    },
    "settings.dataImport.intro.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only ZIP archives with format version 1.x are supported. Newer or older formats will be refused."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur ZIP-Archive mit Format-Version 1.x unterstützt. Neuere oder ältere Formate werden abgelehnt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca format sürümü 1.x olan ZIP arşivleri desteklenir. Daha yeni veya eski formatlar reddedilir."
          }
        }
      }
    },
    "settings.dataImport.strategy.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How the import works"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie der Import arbeitet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarma nasıl çalışır"
          }
        }
      }
    },
    "settings.dataImport.strategy.appendOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Append-only — your existing workouts, records and plans stay untouched; profile and settings are taken from the archive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Append-only — deine bestehenden Workouts, Rekorde und Pläne bleiben unangetastet; Profil und Einstellungen werden aus dem Archiv übernommen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca ekleme — mevcut antrenmanların, rekorların ve planların değişmez; profil ve ayarlar arşivden alınır."
          }
        }
      }
