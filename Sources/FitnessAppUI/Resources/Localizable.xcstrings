    "settings.confirm.reset.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile, all measurements, plans, and workouts will be IRRECOVERABLY lost. The app will start in onboarding."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil, alle Messungen, Pläne und Workout-Sessions gehen UNWIDERRUFLICH verloren. Die App startet danach im Onboarding."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil, tüm ölçümler, planlar ve antrenman oturumları GERİ ALINAMAZ şekilde silinecek. Uygulama ardından tekrar onboarding'den başlayacak."
          }
        }
      }
    },
