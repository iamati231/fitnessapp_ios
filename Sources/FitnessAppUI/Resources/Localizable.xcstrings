    "calc.oneRm.input.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gültig für 1-36 Reps. Bei sehr hohen Reps wird die Schätzung unzuverlässig — die Formeln liefern nur für den Hypertrophie- bis Kraft-Bereich (~1-12 Reps) brauchbare Werte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Valid for 1-36 reps. Estimates get unreliable at very high reps — formulas work best in the hypertrophy-to-strength range (~1-12 reps)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1-36 tekrar için geçerli. Çok yüksek tekrarlarda tahmin güvenilmez olur — formüller hipertrofi-güç aralığında (~1-12 tekrar) en iyi sonucu verir."
          }
        }
      }
    },
    "calc.oneRm.percentages.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rep-Hints sind Faustwerte. Effektive Reps hängen vom Trainings-Status und der Bewegung ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rep hints are rules of thumb. Actual reps depend on training status and the lift."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar ipuçları yaklaşık değerlerdir. Gerçek tekrar; antrenman durumuna ve harekete bağlıdır."
          }
        }
      }
    },
    "calc.oneRm.reps": {
