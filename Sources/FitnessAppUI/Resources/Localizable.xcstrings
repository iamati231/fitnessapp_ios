        "baseline.result.safetyNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hattest oben Vorsicht angegeben — wenn Beschwerden bestehen bleiben, sprich bitte mit einer Ärztin oder einem Arzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You indicated caution above — if symptoms persist, please talk to a doctor first."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yukarıda dikkatli olmanı gerektiren bir durum belirttin — şikayetlerin sürerse lütfen önce bir doktora danış."
          }
        }
      }
    },
    "baseline.result.detailsTitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einzelheiten anzeigen"
