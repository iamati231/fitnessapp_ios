    "onboarding.weeklyGoal.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How often do you want to train per week? Your calendar streak counts against this — pick what you can actually sustain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie oft willst du pro Woche trainieren? Dein Kalender-Streak zählt gegen dieses Ziel — wähle, was du wirklich durchhalten kannst."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada kaç kez antrenman yapmak istiyorsun? Takvim serin bu hedefe göre sayılır — gerçekten sürdürebileceğini seç."
          }
        }
      }
    },
    "onboarding.plan.goalMatch": {
