      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortiert nach Wochentag (Mo-So). „Bearbeiten\" oben rechts aktiviert den Drag-Mode — die Wochentage rotieren entsprechend mit, du musst sie nicht einzeln umstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorted by weekday (Mon-Sun). \"Edit\" top-right enables drag mode — weekdays rotate accordingly, no manual reshuffle needed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafta gününe göre sıralandı (Pzt-Pzr). Sağ üstteki \"Düzenle\" sürükleme modunu etkinleştirir — hafta günleri uygun şekilde döner, tek tek değiştirmen gerekmez."
          }
        }
      }
