            "value": "Erkannt durch Vergleich mit allen vorherigen abgeschlossenen Sessions. Cardio bleibt aussen vor — andere Metrik-Domäne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detected by comparing all previous completed sessions. Cardio excluded — different metric domain."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm önceki tamamlanan oturumlar ile karşılaştırarak tespit edildi. Kardiyo dahil değil — farklı metrik."
          }
        }
      }
    },
    "summary.progressionFooter": {
