    "onboarding.environment.footnote2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hybrid- oder reine Lauf-Athleten wählen ihren Strength-Ort — die Hybrid-Pläne enthalten ihre Run-Tage unabhängig davon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hybrid or pure running athletes pick their strength location — Hybrid plans include run days regardless."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hibrit veya saf koşu sporcuları güç antrenman yerini seçer — Hibrit planlar koşu günlerini her durumda içerir."
          }
        }
      }
    },
