    "plan.template.fullBody3x.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchste Trainingsfrequenz pro Muskelgruppe. Laut Forschung optimal für Anfänger und Wiedereinstieg — maximales Signal für Muskelwachstum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highest training frequency per muscle group. Research-backed as optimal for beginners and re-entry — maximum signal for muscle growth."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas grubu başına en yüksek antrenman frekansı. Araştırmalar başlangıç ve yeniden başlama için ideal olduğunu gösteriyor — kas gelişimi için maksimum sinyal."
          }
        }
      }
    },
    "plan.template.fatBurnFullBody.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fettverlust kommt aus dem Kaloriendefizit — dieser Plan schützt Muskel und Kraft im Cut: solides Hypertrophie-Volumen bei moderaten Lasten plus ein Cardio-Finisher pro Einheit. Reps und Pausen folgen Standard-Hypertrophie (6–12 bzw. 8–15, 60–180 s Pause), kein 'hohe Wdh = Fett weg'-Mythos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fat loss comes from the calorie deficit — this plan preserves muscle and strength during the cut: solid hypertrophy volume at moderate loads plus a cardio finisher per session. Reps and rest follow standard hypertrophy (6–12 or 8–15, 60–180 s rest); no 'high reps melt fat' myth."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yağ kaybı kalori açığından gelir — bu plan diyet sırasında kası ve kuvveti korur: orta yüklerde sağlam hipertrofi hacmi artı her seansta bir kardiyo finisher. Tekrar ve dinlenme standart hipertrofiye uyar (6–12 ya da 8–15, 60–180 sn dinlenme); 'yüksek tekrar = yağ erir' miti yok."
          }
        }
      }
    },
    "plan.template.homeGymHero.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Effektiver Ganzkörperplan komplett mit Kurzhanteln. Ideal für das Training zuhause — kein Fitnessstudio nötig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Effective full-body plan using only dumbbells. Ideal for training at home — no gym required."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece dambıllarla etkili tüm vücut planı. Evde antrenman için ideal — salon gerekmez."
          }
        }
      }
    },
    "plan.template.bodyweightMastery.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komplettes Körpergewichtstraining ohne ein einziges Gerät. Kürzere Pausen und isometrische Übungen sorgen für maximalen Trainingsreiz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete bodyweight training without a single piece of equipment. Shorter rest periods and isometric exercises maximize training stimulus."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek bir ekipman olmadan komple vücut ağırlığı antrenmanı. Kısa molalar ve izometrik hareketler maksimum antrenman uyarısı sağlar."
          }
        }
      }
    },
    "plan.template.pushPullLegs.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissenschaftlich optimierter Split. Jede Muskelgruppe wird 2x pro Woche trainiert – ideal für intermediäre Sportler laut Meta-Analysen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scientifically optimized split. Each muscle group trained 2x per week — ideal for intermediate lifters per meta-analyses."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilimsel olarak optimize edilmiş split. Her kas grubu haftada 2 kez çalıştırılır — meta-analizlere göre orta seviye sporcular için ideal."
          }
        }
      }
    },
    "plan.template.upperLower.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optimale Balance zwischen Frequenz und Volumen. Laut Studienlage der effektivste Split für Kraft- und Muskelaufbau bei Intermediären."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optimal balance between frequency and volume. Studies show this is the most effective split for strength and muscle building at the intermediate level."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Frekans ve hacim arasında optimal denge. Çalışmalar bunun orta seviyede güç ve kas gelişimi için en etkili split olduğunu gösteriyor."
          }
        }
      }
    },
    "plan.template.arnoldSplit.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arnold Schwarzeneggers Trainingsansatz: Antagonisten (Brust+Rücken) werden gemeinsam trainiert für maximalen Pump und Dichte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arnold Schwarzenegger's training approach: antagonist muscles (chest + back) are trained together for maximum pump and density."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arnold Schwarzenegger'in antrenman yaklaşımı: antagonist kaslar (göğüs + sırt) maksimum pump ve yoğunluk için birlikte çalıştırılır."
          }
        }
      }
    },
    "plan.template.broSplit.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klassischer Bodybuilding-Split mit hohem Volumen pro Muskelgruppe. Jede Muskelgruppe wird einmal pro Woche mit maximaler Erschöpfung trainiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Classic bodybuilding split with high volume per muscle group. Each muscle group is trained once per week to maximum exhaustion."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas grubu başına yüksek hacimli klasik vücut geliştirme bölünmesi. Her kas grubu haftada bir kez maksimum yorgunluğa kadar çalıştırılır."
          }
        }
      }
    },
    "plan.template.powerlifting5x5.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das bewährteste Kraft-Programm für Anfänger & Fortgeschrittene. Progressive Überlastung mit den Grundübungen — wissenschaftlich und praktisch belegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most proven strength program for beginners and intermediates. Progressive overload with the main lifts — scientifically and practically validated."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıç ve orta seviye için en kanıtlanmış güç programı. Temel hareketlerle aşamalı yüklenme — bilimsel ve pratik olarak doğrulanmış."
          }
        }
      }
    },
    "plan.template.powerlifting3x5.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreier-Frequenz auf die Grundübungen Kniebeuge, Bankdrücken und Kreuzheben. Jede Session dreht sich um eine primäre Wettkampfübung mit schweren 3x5-Sätzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Triple frequency on the core lifts: squat, bench press, and deadlift. Each session focuses on one primary competition lift with heavy 3x5 sets."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temel hareketler (squat, bench press, deadlift) için üçlü frekans. Her seans ağır 3x5 setleriyle bir ana yarışma hareketine odaklanır."
          }
        }
      }
    },
    "plan.template.footballAthletic.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Athletik-Programm für Mannschaftssportler: Maximalkraft und Schnellkraft in zwei kompakten Einheiten pro Woche — ideal als Ergänzung zum Vereinstraining."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Athletics program for team-sport athletes: maximum strength and power in two compact sessions per week — ideal as a complement to club training."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takım sporcuları için atletik program: haftada iki kompakt seansta maksimum güç ve patlayıcı kuvvet — kulüp antrenmanına ideal tamamlayıcı."
          }
        }
      }
    },
    "plan.template.hybridBeginner.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Concurrent-Training light: zwei Ganzkörper-Strength-Einheiten + zwei lockere Lauf-Tage pro Woche. RIR-Puffer schützt den Laufmotor, kein zerstörendes Versagens-Training."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Concurrent training light: two full-body strength sessions + two easy run days per week. RIR buffer protects the running engine — no destructive failure training."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafif eşzamanlı antrenman: haftada iki tüm vücut güç seansı + iki kolay koşu günü. RIR tamponu koşu motorunu korur — yıkıcı başarısızlık antrenmanı yok."
          }
        }
      }
    },
    "plan.template.hybridBalanced.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei fokussierte Strength-Einheiten (Push/Pull/Legs-Light) plus zwei strategisch platzierte Lauf-Tage. RIR-Puffer 2–3 verhindert systemische Erschöpfung — bleibt Trainings-vertrāglich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three focused strength sessions (Push/Pull/Legs-Light) plus two strategically placed run days. RIR buffer of 2–3 prevents systemic fatigue — stays training-compatible."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üç odaklı güç seansı (Push/Pull/Hafif Bacak) artı iki stratejik konumlandırılmış koşu günü. RIR tamponu 2–3 sistemik yorgunluğu önler — antrenmana uyumlu kalır."
          }
        }
      }
    },
    "plan.template.hybridPerformance.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sechs Trainingstage: drei Strength-Einheiten (Push/Pull/Legs) + drei Läufe (Easy, Intervalle, Long Run). Strength-RIR konservativ 2.5, damit der Gesamt-Volumen-Stress trainings-vertraglich bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Six training days: three strength sessions (Push/Pull/Legs) + three runs (Easy, Intervals, Long Run). Conservative RIR of 2.5 on strength to keep total volume stress training-compatible."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altı antrenman günü: üç güç seansı (Push/Pull/Bacak) + üç koşu (Kolay, İnterval, Uzun Koşu). Toplam hacim stresinin antrenmana uyumlu kalması için güçte ihtiyatlı RIR 2.5."
          }
        }
      }
    },
