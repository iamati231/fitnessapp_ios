    "plan.template.kettlebellComplexes.tagline": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "5 Tage · Ganzkörper-Komplexe für Athletik & Kraftausdauer" } },
        "en": { "stringUnit": { "state": "translated", "value": "5 days · Full-body complexes for athleticism & muscular endurance" } },
        "tr": { "stringUnit": { "state": "translated", "value": "5 gün · Atletizm ve kas dayanıklılığı için tüm vücut kompleksleri" } }
      }
    },
    "plan.template.kettlebellComplexes.description": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Fünf eigenständige Kettlebell-Komplexe für Ganzkörper-Athletik - von rundenbasierten Ganzkörper- und Explosivitäts-Komplexen bis zu einem AMRAP-Finisher für die Körpermitte. Moderates Gewicht wählen, saubere Technik vor Tempo." } },
        "en": { "stringUnit": { "state": "translated", "value": "Five standalone kettlebell complexes for full-body athleticism - from round-based full-body and explosive complexes to an AMRAP finisher for your core. Choose a moderate weight, clean technique before speed." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Tüm vücut atletizmi için beş bağımsız kettlebell kompleksi - tur bazlı tüm vücut ve patlayıcı kompleksten karın bölgesi için bir AMRAP bitirişine kadar. Orta ağırlık seç, hız yerine temiz teknik." } }
      }
    },
    "plan.template.kettlebellComplexes.focus": {
      "extractionState": "manual",
