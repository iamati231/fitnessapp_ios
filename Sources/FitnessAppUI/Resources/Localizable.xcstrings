    "baseline.result.phaseNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Check ist gespeichert und fließt in künftige Anpassungen ein — dein aktueller Plan ändert sich dadurch jetzt noch nicht automatisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your check is saved and will inform future adjustments — it doesn't change your current plan automatically yet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolün kaydedildi ve gelecekteki ayarlamalara yansıyacak — şu an mevcut planını otomatik olarak değiştirmiyor."
          }
        }
      }
    },
    "baseline.result.planButton": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
