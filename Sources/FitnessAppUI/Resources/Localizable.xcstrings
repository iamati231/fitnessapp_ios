    "baseline.family.legs.cue1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Knie zeigen in Richtung der Zehen, nicht nach innen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knees track toward your toes, not inward."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dizler ayak uçlarına doğru gider, içe çökmez."
          }
        }
      }
    },
    "baseline.family.legs.cue2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolliert runter, kontrolliert wieder hoch."
