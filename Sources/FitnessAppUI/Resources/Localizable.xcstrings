            "value": "Tap an exercise to edit. \"Edit\" top-right enables drag handles for reordering — superset partners move together."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenlemek için bir harekete dokun. Sağ üstteki \"Düzenle\" sıralama tutamaçlarını etkinleştirir — süperset eşleri birlikte hareket eder."
          }
        }
      }
    },
    "day.editor.timedFormat.hintAmrap": {
