    "day.analysis.coachNote.balanced": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewogener Tag mit solidem Reiz und moderater Ermüdung. Gut planbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Balanced session with solid stimulus and moderate fatigue. Easy to plan around."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengeli bir gün — sağlam uyaran, orta düzey yorgunluk. Planlamak kolay."
          }
        }
      }
    },
    "day.analysis.coachNote.highLocal": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoher lokaler Reiz bei moderater Systemlast — klassischer Hypertrophie-Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High local stimulus with moderate systemic load — classic hypertrophy day."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüksek yerel uyaran, orta düzey sistemik yük — klasik hipertrofi günü."
          }
        }
      }
    },
    "day.analysis.coachNote.compoundHeavy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemisch fordernder Compound-Tag. Plane danach eher Erholung oder einen leichten Oberkörper-Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemically demanding compound day. Plan for recovery or a light upper-body day afterwards."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistemik olarak zorlayıcı bir compound günü. Sonrasında toparlanma veya hafif üst vücut günü planla."
          }
        }
      }
    },
    "day.analysis.coachNote.veryHighStress": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehr hohe Belastung. Achte danach besonders auf Schlaf und Nahrung — und plane keinen zweiten harten Tag direkt im Anschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Very high load. Pay extra attention to sleep and food afterwards — and don't stack another hard day right after."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok yüksek yük. Sonrasında uykuya ve beslenmeye özellikle dikkat et — ve hemen ardına başka bir zor gün koyma."
          }
        }
      }
    },
    "day.analysis.coachNote.lightDeload": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geringer Reiz — passend für Deload, Technik oder Erhaltung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low stimulus — ideal for deload, technique, or maintenance."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşük uyaran — deload, teknik veya koruma için ideal."
          }
        }
      }
    },
    "day.analysis.coachNote.cardioFocused": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiner Cardio-Tag. Halte den Reiz konstant und beobachte die Erholung der Beine bis zum nächsten Krafttag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pure cardio day. Keep the stimulus steady and watch leg recovery before the next strength session."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamen kardiyo gün. Uyaranı sabit tut ve bir sonraki güç gününe kadar bacak toparlanmasını gözle."
          }
        }
      }
    },
    "day.analysis.coachNote.metabolicDensity": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Ein Zeitformat-Tag: Die Belastung kommt hier aus der Dichte, nicht aus dem Gewicht." } },
        "en": { "stringUnit": { "state": "translated", "value": "A time-format day: the load here comes from density, not from weight." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Bir zaman formatı günü: Buradaki yük ağırlıktan değil, yoğunluktan gelir." } }
      }
    },
    "day.analysis.coachNote.metabolicDensity.amrap": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "%@ ohne feste Pause. Die Belastung kommt hier aus der Dichte, nicht aus dem Gewicht." } },
        "en": { "stringUnit": { "state": "translated", "value": "%@ with no fixed rest. The load here comes from density, not weight." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Sabit molasız %@. Buradaki yük ağırlıktan değil, yoğunluktan gelir." } }
      }
    },
    "day.analysis.coachNote.metabolicDensity.emom": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "%@ im Minutentakt. Die Pause steckt in der Minute selbst, nicht dazwischen." } },
        "en": { "stringUnit": { "state": "translated", "value": "%@ on the minute. The rest lives inside the minute itself, not between them." } },
        "tr": { "stringUnit": { "state": "translated", "value": "%@ dakika bazında. Mola dakikanın kendi içinde, aralarda değil." } }
      }
    },
    "day.analysis.coachNote.metabolicDensity.forTime": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "%@ im eigenen Tempo. Die Belastung kommt aus der Dichte, nicht aus dem Gewicht." } },
        "en": { "stringUnit": { "state": "translated", "value": "%@ at your own pace. The load comes from density, not weight." } },
        "tr": { "stringUnit": { "state": "translated", "value": "%@ kendi temponda. Yük ağırlıktan değil, yoğunluktan gelir." } }
      }
    },
