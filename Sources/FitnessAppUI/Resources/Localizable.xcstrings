    "day.restDay.heroMessage": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeneration ist Teil des Plans. Hak den Tag ab, wenn du durch bist — dein Plan-Pointer springt automatisch zum nächsten echten Training."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery is part of the plan. Check off the day when you're done — your plan pointer jumps to the next real training day automatically."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toparlanma planın bir parçasıdır. Bitince günü işaretle — plan işaretçisi otomatik olarak bir sonraki gerçek antrenman gününe atlar."
          }
        }
      }
    },
    "day.restDay.complete.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiert den Ruhetag als erledigt — kein leerer Eintrag in der History, aber der Plan-Pointer rückt zum nächsten echten Training."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marks the rest day as done — no empty history entry, but the plan pointer advances to the next real training day."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinlenme gününü tamamlandı olarak işaretler — geçmişte boş kayıt olmaz ama plan işaretçisi bir sonraki gerçek antrenmana ilerler."
          }
        }
      }
    },
