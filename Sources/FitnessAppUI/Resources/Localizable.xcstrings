    "planEditor.envSwap.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sollen die Übungen an deinen neuen Trainingsort angepasst werden? Übungen ohne passende Alternative bleiben im Plan und brauchen manuelle Anpassung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapt exercises to the new training location? Exercises without a matching alternative stay in the plan and need manual adjustment."
          }
