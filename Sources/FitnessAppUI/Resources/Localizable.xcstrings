    "measurement.ratio.whr.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WHR < 0,80 = gesundes Risikoprofil bei Frauen. > 0,85 = erhöhtes Risiko."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WHR < 0.80 = healthy risk profile for women. > 0.85 = elevated risk."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "WHR < 0,80 = kadınlarda sağlıklı risk profili. > 0,85 = artmış risk."
          }
        }
      }
    },
    "measurement.ratio.swr.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldener V-Schnitt ~ 1,618 (Schulter ≈ 1,6× Taille). SWR < 1,3 = wenig V-Form, > 1,5 = ausgeprägt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Golden V-taper ≈ 1.618 (shoulder ≈ 1.6× waist). SWR < 1.3 = little V-shape, > 1.5 = pronounced."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altın V-kesimi ≈ 1,618 (omuz ≈ 1,6× bel). SWR < 1,3 = az V-şekli, > 1,5 = belirgin."
          }
        }
      }
    },
