    "cardioFeasibility.detail.feasible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You need about %1$lld weeks, %2$lld are available – that's enough."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du brauchst rechnerisch %1$lld Wochen, verfügbar sind %2$lld – das reicht."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaba göre %1$lld hafta gerekiyor, %2$lld hafta mevcut – bu yeterli."
          }
        }
      }
    },
    "cardioFeasibility.detail.infeasibleWithSuggestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You need about %1$lld weeks, but only %2$lld are available. A more realistic goal right now: %3$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du brauchst rechnerisch %1$lld Wochen, verfügbar sind nur %2$lld. Realistischer wäre aktuell: %3$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaba göre %1$lld hafta gerekiyor, ama sadece %2$lld hafta mevcut. Şu an daha gerçekçi bir hedef: %3$@."
          }
        }
      }
    },
    "cardioFeasibility.detail.infeasibleNoSuggestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You need about %1$lld weeks, but only %2$lld are available. Even a smaller goal no longer fits in the remaining time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du brauchst rechnerisch %1$lld Wochen, verfügbar sind nur %2$lld. Selbst ein kleineres Ziel passt nicht mehr in die verbleibende Zeit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaba göre %1$lld hafta gerekiyor, ama sadece %2$lld hafta mevcut. Daha küçük bir hedef bile kalan süreye sığmıyor."
          }
        }
      }
