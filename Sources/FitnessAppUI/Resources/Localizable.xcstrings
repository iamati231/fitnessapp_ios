    "timedWorkout.circuit.pauseHint": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Nutze die Pause zum Durchatmen - die naechste Runde startet automatisch, sobald die Zeit um ist." } },
        "en": { "stringUnit": { "state": "translated", "value": "Use the rest to catch your breath - the next round starts automatically once time's up." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Nefes almak icin molayi kullan - sure dolunca bir sonraki tur otomatik baslar." } }
      }
    },
    "timedWorkout.circuit.fixedRepsHint": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Hake jede Uebung ab, sobald du ihr Ziel fuer diese Runde geschafft hast." } },
        "en": { "stringUnit": { "state": "translated", "value": "Check off each exercise once you've hit its target for this round." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Bu turdaki hedefine ulastigin her egzersizi isaretle." } }
      }
    },
    "timedWorkout.circuit.toFailureHint": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Wiederhole die Sequenz, bis keine sauberen Wiederholungen mehr moeglich sind, dann \"Runde beenden\" antippen." } },
        "en": { "stringUnit": { "state": "translated", "value": "Repeat the sequence until no more clean reps are possible, then tap \"End round\"." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Temiz tekrar yapamayana kadar diziyi tekrarla, sonra \"Turu bitir\"e dokun." } }
      }
    },
