    "editor.exercise.deleteConfirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bist du sicher? Diese Custom-Übung verschwindet dauerhaft. Bereits geloggte Trainings bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure? This custom exercise is removed permanently. Already logged workouts stay intact."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emin misin? Bu özel hareket kalıcı olarak silinir. Kaydedilmiş antrenmanlar korunur."
          }
        }
      }
    },
