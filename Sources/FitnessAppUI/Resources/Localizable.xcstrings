          "stringUnit": {
            "state": "translated",
            "value": "Wenn aus, siehst du auch Übungen, die zu deinem Plan-Typ nicht passen. Die App fragt dann beim Hinzufügen nach, ob du den Plan umstellen willst."
          }
        },
        "en": {
