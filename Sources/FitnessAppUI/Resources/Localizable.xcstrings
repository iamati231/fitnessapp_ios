    "settings.dataImport.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing workouts, records, measurements and plans stay untouched. Missing rows from the archive are added, duplicates are detected and skipped – only plans are always added as new plans. Your profile and app settings are overwritten with the values from the archive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestehende Workouts, Rekorde, Messungen und Pläne bleiben unangetastet. Fehlende Zeilen aus dem Archiv werden ergänzt, Duplikate erkannt und übersprungen – nur Pläne werden immer als neue Pläne angelegt. Profil und App-Einstellungen werden mit den Werten aus dem Archiv überschrieben."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut antrenmanların, rekorların, ölçümlerin ve planların değişmez. Arşivdeki eksik satırlar eklenir, yinelenen kayıtlar algılanır ve atlanır; yalnızca planlar her zaman yeni plan olarak eklenir. Profilin ve uygulama ayarların arşivdeki değerlerle değiştirilir."
          }
        }
      }
    },
    "settings.dataImport.confirm.action": {
      "extractionState": "manual",
      "localizations": {
