    "day.editor.templateLocked.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Tag gehört zu einem vorgefertigten Plan-Template und kann strukturell nicht bearbeitet werden. Du kannst aber die Trainings-Intensität anpassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This day belongs to a built-in plan template and can't be edited structurally. You can adjust training intensity though."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün hazır bir plan şablonuna ait ve yapısal olarak düzenlenemez. Ancak antrenman yoğunluğunu ayarlayabilirsin."
          }
        }
      }
    },
    "day.editor.templateLocked.exercises": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Template-Plan — Übungen sind festgelegt. Du kannst sie ansehen, aber nicht hinzufügen, entfernen oder umsortieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Template plan — exercises are fixed. You can view them but not add, remove, or reorder."
          }
