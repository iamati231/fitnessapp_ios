    "backups.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deltiq sichert deine Daten automatisch, wenn du die App verlässt — höchstens einmal pro Tag. Die letzten fünf Sicherungen bleiben erhalten und liegen in der Dateien-App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deltiq backs up your data automatically when you leave the app — at most once a day. The five most recent backups are kept and stored in the Files app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deltiq, uygulamadan çıktığında verilerini otomatik olarak yedekler — günde en fazla bir kez. En son beş yedek saklanır ve Dosyalar uygulamasında bulunur."
          }
        }
      }
    },
    "backups.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Backups"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No backups yet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz yedek yok"
          }
        }
      }
    },
    "backups.empty.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald du ein Training aufgezeichnet hast, legt Deltiq beim nächsten Verlassen der App die erste Sicherung an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you've recorded a workout, Deltiq creates the first backup the next time you leave the app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir antrenman kaydettiğinde, Deltiq uygulamadan bir sonraki çıkışında ilk yedeği oluşturur."
          }
        }
      }
    },
