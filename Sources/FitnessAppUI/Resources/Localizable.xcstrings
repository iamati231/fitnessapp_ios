    "settings.dataExport.intro.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What this does"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was das macht"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ne yapar"
          }
        }
