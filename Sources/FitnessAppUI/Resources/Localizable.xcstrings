    "planEditor.envSwap.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sollen die Übungen an deinen neuen Trainingsort angepasst werden? Übungen ohne passende Alternative bleiben im Plan und brauchen manuelle Anpassung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapt exercises to the new training location? Exercises without a matching alternative stay in the plan and need manual adjustment."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareketler yeni antrenman yerine uyarlansın mı? Uygun alternatifi olmayan hareketler planda kalır ve manuel ayarlama gerektirir."
          }
        }
      }
    },
    "planEditor.envRestore.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben gespeicherte Original-Übungen aus einem früheren Equipment-Wechsel gefunden. Möchtest du diese wiederherstellen (inkl. der letzten Arbeitsgewichte aus der Historie), statt das aktuelle Setup neu anzupassen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We found saved original exercises from a previous equipment change. Restore them (with the last working weights from history) instead of re-adapting the current setup?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki bir ekipman değişikliğinden orijinal hareketler bulduk. Mevcut kurulumu yeniden uyarlamak yerine bunları (geçmişten son çalışma ağırlıklarıyla) geri yüklemek ister misin?"
          }
        }
      }
    },
