    "backups.restore.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine aktuellen Daten werden durch den Stand von %@ ersetzt. Vorher legt Deltiq automatisch eine Sicherung des JETZIGEN Stands an, damit du zurück kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current data will be replaced with the backup from %@. Deltiq first saves a backup of your CURRENT data so you can go back."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut verilerin %@ tarihli yedekle değiştirilecek. Deltiq önce ŞU ANKİ verilerinin bir yedeğini alır, böylece geri dönebilirsin."
          }
        }
      }
    },
