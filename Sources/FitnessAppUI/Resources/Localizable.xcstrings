    "settings.timer.prCelebrations": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PR-Feiern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Celebrate PRs"
