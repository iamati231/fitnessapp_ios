    "onboarding.health.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du Apple Health verbindest, ziehen wir Alter, Geschlecht, Größe und Gewicht aus deinem Profil — du musst nichts doppelt tippen. Diesen Schritt kannst du auch überspringen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect Apple Health and we'll pull age, sex, height, and weight from your profile — no double-entry. You can also skip this step."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health'i bağlarsan yaş, cinsiyet, boy ve kilonu profilinden çekeriz — iki kere yazmana gerek yok. Bu adımı atlayabilirsin."
          }
        }
      }
    },
