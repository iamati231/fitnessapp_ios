    "dashboard.deload.activeBanner": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deload week active until %@ — working weights reduced by ~50%%. Train the movements, skip the grind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deload-Woche aktiv bis %@ — Arbeitsgewichte um ~50%% reduziert. Trainiere die Bewegungen, lass das Schleifen weg."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deload haftası %@ tarihine kadar aktif — çalışma ağırlıkları ~%%50 azaltıldı. Hareketleri çalış, kendini ezme."
          }
        }
      }
    },
    "dashboard.deload.activeBannerNoDate": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deload-Woche aktiv — Arbeitsgewichte halbiert. Trainiere die Bewegungen, lass das Schleifen weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deload week active — working weights halved. Train the movements, skip the grind."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deload haftası aktif — çalışma ağırlıkları yarıya indirildi. Hareketleri çalış, kendini ezme."
          }
        }
      }
    },
    "dashboard.deload.endButton": {
      "extractionState": "manual",
      "localizations": {
