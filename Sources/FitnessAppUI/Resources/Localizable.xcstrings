      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore from an export"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von einem Export wiederherstellen"
          }
        },
        "tr": {
          "stringUnit": {
