    "comeback.prompt.preview.none": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei dieser Reduktion ändert sich auf dem Scheiben-Raster nichts. Wähle einen höheren Wert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At this reduction nothing changes on the plate increments. Pick a higher value."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu azaltmada plaka kademelerinde hiçbir şey değişmiyor. Daha yüksek bir değer seç."
          }
        }
      }
    },
    "comeback.prompt.retest": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach so langer Pause ist ein Tastversuch sinnvoller als eine geschätzte Reduktion: geh die ersten Sätze bewusst leicht an und finde deine Last neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a break this long, feeling it out beats a guessed reduction: start the first sets deliberately light and find your load again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kadar uzun bir moladan sonra tahmini bir azaltma yerine yoklamak daha mantıklı: ilk setlere bilinçli olarak hafif başla ve yükünü yeniden bul."
          }
        }
      }
    },
