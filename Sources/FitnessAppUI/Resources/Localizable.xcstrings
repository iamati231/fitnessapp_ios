    "active.finish.feeling.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App nutzt das für die Progression: Wenn du am Limit warst, halten wir das Gewicht stabil — kein Zwangs-Plus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We use this for progression: when you were at the limit, we keep the weight stable — no forced increase."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu ilerleme için kullanırız: limitteydiysen ağırlığı sabit tutarız — zorla artırma yok."
          }
        }
      }
    },
    "active.finish.feeling.noProgression": {
