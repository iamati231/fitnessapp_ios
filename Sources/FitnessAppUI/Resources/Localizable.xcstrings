    "settings.healthWrite.confirmTitle": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Trainings nach Health schreiben?" } },
        "en": { "stringUnit": { "state": "translated", "value": "Write workouts to Health?" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Antrenmanlar Health'e yazılsın mı?" } }
      }
    },
    "settings.healthWrite.confirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Für jedes Training entsteht ein Eintrag mit Start, Dauer und Art, bei Krafttraining mit den Namen der Übungen – ohne Kalorien und Puls. In Deltiq lässt sich das nicht rückgängig machen, nur in Health. Health kann die Trainings bei Trainingsminuten und Stehen vergangener Tage mitrechnen; mit einer Apple Watch kann das doppelt zählen." } },
        "en": { "stringUnit": { "state": "translated", "value": "Each workout becomes an entry with start, duration and type, with the names of the exercises for strength training – without calories and heart rate. This cannot be undone in Deltiq, only in Health. Health may count the workouts towards exercise minutes and stand hours of past days; with an Apple Watch this can count twice." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Her antrenman için başlangıç, süre ve türü içeren, kuvvet antrenmanında ayrıca egzersizlerin adlarını taşıyan bir kayıt oluşur – kalori ve nabız olmadan. Bu, Deltiq'te geri alınamaz, yalnızca Health'te. Health antrenmanları geçmiş günlerin egzersiz dakikalarına ve ayakta kalma saatlerine katabilir; Apple Watch ile bu iki kez sayılabilir." } }
      }
    },
    "settings.healthWrite.confirmAction": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Ja, jetzt schreiben" } },
        "en": { "stringUnit": { "state": "translated", "value": "Yes, write now" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Evet, şimdi yaz" } }
      }
    },
