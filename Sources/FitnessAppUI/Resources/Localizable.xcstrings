    "settings.reminders.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Benachrichtigungen — keine Server-Verbindung. Tippen auf eine Erinnerung öffnet direkt den passenden Tab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local notifications — no server connection. Tapping a reminder opens the matching tab."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel bildirimler — sunucu bağlantısı yok. Bir hatırlatıcıya dokunmak doğru sekmeyi açar."
          }
        }
      }
    },
    "settings.health.lastSync": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzter Sync"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last Sync"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son Senkronizasyon"
          }
        }
      }
    },
    "settings.health.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei aktivierter Verbindung wird im Messwerte-Formular das letzte Waagen-Gewicht vorausgefüllt. Beim Speichern werden Gewicht, KFA und Magere Masse zurück nach Apple Health geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When connected, the measurement form prefills your last scale weight. Saving writes weight, body fat %, and lean mass back to Apple Health."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlıyken ölçüm formu son tartı kilonu önceden doldurur. Kaydetme; kilo, yağ oranı ve yağsız kütleyi Apple Health'e yazar."
          }
        }
      }
    },
    "settings.healthWrite.row": {
