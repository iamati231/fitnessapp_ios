    "baseline.safety.question": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hast du aktuell Schmerzen, Schwindel, Brustschmerzen oder eine ärztliche Einschränkung für Sport?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you currently have pain, dizziness, chest pain, or a medical restriction for exercise?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda ağrın, baş dönmen, göğüs ağrın veya spor için tıbbi bir kısıtlaman var mı?"
          }
        }
      }
    },
                "baseline.safety.flaggedNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles gut — wir überspringen die Belastungstests und starten vorsichtig. Bei anhaltenden Beschwerden sprich bitte vorher mit einer Ärztin oder einem Arzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All good — we'll skip the exertion tests and start carefully. If symptoms persist, please talk to a doctor first."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorun değil — zorlayıcı testleri atlıyoruz ve dikkatli başlıyoruz. Şikayetlerin sürerse lütfen önce bir doktora danış."
          }
        }
      }
    },
    "baseline.safety.option.clear": {
      "extractionState": "manual",
      "localizations": {
