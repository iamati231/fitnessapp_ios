          "stringUnit": {
            "state": "translated",
            "value": "Gewicht, Hals, Taille und Hüfte werden für die Navy-KFA-Berechnung benötigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weight, neck, waist, and hip are required for the Navy body-fat calculation."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Navy yağ oranı hesabı için ağırlık, boyun, bel ve kalça gereklidir."
