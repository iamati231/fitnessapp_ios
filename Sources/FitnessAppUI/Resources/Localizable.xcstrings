    "measurement.section.core.footer.male": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewicht, Hals und Taille werden für die Navy-KFA-Berechnung benötigt. Schulter optional für das Schulter-zu-Taillen-Verhältnis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weight, neck, and waist are required for the Navy body-fat calculation. Shoulder is optional for the shoulder-to-waist ratio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Navy yağ oranı hesabı için ağırlık, boyun ve bel gereklidir. Omuz, omuz-bel oranı için isteğe bağlıdır."
          }
        }
      }
    },
    "measurement.section.core.footer.female": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewicht, Hals, Taille und Hüfte werden für die Navy-KFA-Berechnung benötigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weight, neck, waist, and hip are required for the Navy body-fat calculation."
