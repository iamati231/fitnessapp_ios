    "day.editor.timedFormat.hintCircuit": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Feste Rundenzahl, feste Pause dazwischen — je nach Modus zaehlst du entweder feste Wiederholungen ab oder beendest die Runde selbst, wenn du am Limit bist." } },
        "en": { "stringUnit": { "state": "translated", "value": "Fixed round count, fixed rest in between — depending on the mode you either count off fixed reps or end the round yourself once you've hit your limit." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Sabit tur sayısı, aralarda sabit mola — moda göre ya sabit tekrarları sayarsın ya da limitine ulaştığında turu kendin bitirirsin." } }
      }
    },
    "day.analysis.coachNote.metabolicDensity.circuit": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "%@ mit fester Pause zwischen den Runden. Die Belastung kommt aus der Dichte pro Runde, nicht aus dem Gewicht." } },
        "en": { "stringUnit": { "state": "translated", "value": "%@ with a fixed rest between rounds. The load comes from the density per round, not the weight." } },
        "tr": { "stringUnit": { "state": "translated", "value": "%@ turlar arasında sabit molayla. Yük ağırlıktan değil, tur başına yoğunluktan gelir." } }
      }
    },
