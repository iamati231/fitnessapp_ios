      }
    },
    "settings.healthWrite.title": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Trainings an Health senden" } },
        "en": { "stringUnit": { "state": "translated", "value": "Send workouts to Health" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Antrenmanları Health'e gönder" } }
      }
    },
    "settings.healthWrite.introHeader": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Trainings speichern" } },
        "en": { "stringUnit": { "state": "translated", "value": "Save workouts" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Antrenmanları kaydet" } }
      }
    },
    "settings.healthWrite.introBody": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Deltiq kann abgeschlossene Trainings in Apple Health speichern: Start, Dauer und Art, bei Krafttraining mit den Namen der Übungen, bei Läufen auf Wunsch auch die Distanz. Kalorien und Puls schreibt Deltiq nicht. Apple kennt nur „Trainings“ als Ganzes – was Deltiq davon schreibt, stellst du hier ein." } },
        "en": { "stringUnit": { "state": "translated", "value": "Deltiq can save completed workouts to Apple Health: start, duration and type – with the names of the exercises for strength training and, if you like, the distance for runs. Deltiq does not write calories or heart rate. Apple only knows “Workouts” as a whole – what Deltiq writes of them is up to you here." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Deltiq, tamamlanan antrenmanları Apple Health'e kaydedebilir: başlangıç, süre ve tür; kuvvet antrenmanında egzersizlerin adlarıyla birlikte, istersen koşularda mesafe de. Deltiq kalori ve nabız yazmaz. Apple yalnızca „Antrenmanlar“ı bütün olarak tanır – Deltiq'in bunlardan neyi yazacağını burada sen belirlersin." } }
      }
    },
    "settings.healthWrite.accessHeader": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Zugriff" } },
        "en": { "stringUnit": { "state": "translated", "value": "Access" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Erişim" } }
      }
    },
    "settings.healthWrite.accessGranted": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Zugriff erlaubt" } },
        "en": { "stringUnit": { "state": "translated", "value": "Access allowed" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Erişime izin verildi" } }
      }
    },
    "settings.healthWrite.accessNone": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Noch nicht freigegeben" } },
        "en": { "stringUnit": { "state": "translated", "value": "Not allowed yet" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Henüz izin verilmedi" } }
      }
    },
    "settings.healthWrite.accessButton": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Zugriff erlauben" } },
        "en": { "stringUnit": { "state": "translated", "value": "Allow access" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Erişime izin ver" } }
      }
    },
    "settings.healthWrite.accessHint": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Apple fragt einmal nach – für das Schreiben und das Lesen von „Trainings“. Das Lesen braucht Deltiq für den Workout-Import und den Abgleich beim Export. Du kannst den Zugriff jederzeit in Health widerrufen." } },
        "en": { "stringUnit": { "state": "translated", "value": "Apple asks once – for writing and reading “Workouts”. Deltiq needs reading for the workout import and the check during export. You can withdraw access in Health at any time." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Apple bir kez sorar – „Antrenmanlar“ı yazma ve okuma için. Okuma, antrenman içe aktarma ve dışa aktarırken yapılan karşılaştırma için gerekir. Erişimi istediğin zaman Health'ten geri alabilirsin." } }
      }
    },
    "settings.healthWrite.accessNoDialog": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Keine Freigabe erteilt. Tippe erneut auf „Zugriff erlauben“ oder erlaube „Trainings“ in der Health-App unter Profil → Apps → Deltiq." } },
        "en": { "stringUnit": { "state": "translated", "value": "No access granted. Tap “Allow access” again, or allow “Workouts” in the Health app under Profile → Apps → Deltiq." } },
        "tr": { "stringUnit": { "state": "translated", "value": "İzin verilmedi. Tekrar „Erişime izin ver“e dokun veya Health uygulamasında Profil → Uygulamalar → Deltiq altında „Antrenmanlar“a izin ver." } }
      }
    },
    "settings.healthWrite.accessBlocked": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Fehlt dort der Schalter „Trainings“, kann iOS die Frage nicht noch einmal stellen: Sie gilt als beantwortet, zum Beispiel weil „Trainings“ zuerst nur zum Lesen angefragt wurde (Workout-Import). Dann hilft voraussichtlich nur, Deltiq zu löschen und neu zu installieren. Sichere vorher deine Daten mit „Daten exportieren (CSV)“ und lege die ZIP-Datei außerhalb von Deltiq ab, etwa in iCloud Drive." } },
        "en": { "stringUnit": { "state": "translated", "value": "If the “Workouts” switch is missing there, iOS can no longer ask: the question counts as answered, for example because “Workouts” was first requested for reading only (workout import). Then it will most likely only be fixed by deleting and reinstalling Deltiq. Back up your data first with “Export data (CSV)” and save the ZIP file outside Deltiq, for example in iCloud Drive." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Orada „Antrenmanlar“ anahtarı yoksa iOS soruyu bir daha soramaz: Soru yanıtlanmış sayılır, örneğin „Antrenmanlar“ önce yalnızca okuma için istendiği için (antrenman içe aktarma). Bunun çözümü büyük olasılıkla yalnızca Deltiq'i silip yeniden yüklemektir. Öncesinde verilerini „Verileri dışa aktar (CSV)“ ile yedekle ve ZIP dosyasını Deltiq dışında, örneğin iCloud Drive'da sakla." } }
      }
    },
    "settings.healthWrite.openHealthApp": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Health-App öffnen" } },
        "en": { "stringUnit": { "state": "translated", "value": "Open Health app" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Health uygulamasını aç" } }
      }
    },
    "settings.healthWrite.accessDeniedLabel": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Zugriff nicht erteilt" } },
        "en": { "stringUnit": { "state": "translated", "value": "Access not granted" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Erişim verilmedi" } }
      }
    },
    "settings.healthWrite.accessDenied": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Öffne die Health-App → Profil → Apps → Deltiq und schalte unter „darf Daten schreiben“ den Schalter „Trainings“ ein. Danach zeigt Deltiq hier den neuen Stand." } },
        "en": { "stringUnit": { "state": "translated", "value": "Open the Health app → Profile → Apps → Deltiq and turn on “Workouts” among the data Deltiq may write. Deltiq then shows the new state here." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Health uygulamasını aç → Profil → Uygulamalar → Deltiq ve Deltiq'in yazabileceği veriler arasında „Antrenmanlar“ı aç. Deltiq yeni durumu burada gösterir." } }
      }
    },
    "settings.healthWrite.switchesHeader": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Was Deltiq schreibt" } },
        "en": { "stringUnit": { "state": "translated", "value": "What Deltiq writes" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Deltiq neyi yazar" } }
      }
    },
    "settings.healthWrite.strengthLabel": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Krafttraining schreiben" } },
        "en": { "stringUnit": { "state": "translated", "value": "Write strength workouts" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Kuvvet antrenmanlarını yaz" } }
      }
    },
    "settings.healthWrite.strengthFooter": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Auch AMRAP, EMOM, Auf Zeit und Zirkel – außer Tagen, die nur aus Cardio-Übungen bestehen, die zählen zu Cardio. Trägst du dabei eine Apple Watch, nimmt sie das Training schon auf – dann lass das aus, sonst steht es doppelt in Health." } },
        "en": { "stringUnit": { "state": "translated", "value": "Includes AMRAP, EMOM, For Time and circuits – except days made up only of cardio exercises, which count as cardio. If you wear an Apple Watch while training it already records the workout – turn this off, or it appears twice in Health." } },
        "tr": { "stringUnit": { "state": "translated", "value": "AMRAP, EMOM, Süreye Karşı ve Devre dahil – yalnızca kardiyo egzersizlerinden oluşan günler hariç, onlar kardiyoya sayılır. Antrenman sırasında Apple Watch takıyorsan antrenmanı zaten o kaydeder – bunu kapat, yoksa Health'te iki kez görünür." } }
      }
    },
    "settings.healthWrite.cardioLabel": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Cardio schreiben" } },
        "en": { "stringUnit": { "state": "translated", "value": "Write cardio" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Kardiyoyu yaz" } }
      }
    },
    "settings.healthWrite.cardioFooter": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Laufen, Radfahren, Rudern und mehr, die du in Deltiq selbst erfasst – auch reine Cardio-Tage mit Zeitformat. Schreibt schon eine andere App (z. B. Adidas Running) deine Läufe, lass das aus. Aus anderen Apps übernommene Einheiten schickt Deltiq nie zurück. Die Distanz kommt nur mit der zusätzlichen Freigabe „Geh- und Laufdistanz“; ohne sie wird das Training ohne Distanz gespeichert." } },
        "en": { "stringUnit": { "state": "translated", "value": "Running, cycling, rowing and more that you record in Deltiq yourself – including pure cardio days with a time format. If another app (e.g. Adidas Running) already writes your runs, leave this off. Deltiq never sends workouts taken over from other apps back. The distance is only included with the additional “Walking + Running Distance” permission; without it the workout is saved without distance." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Deltiq'te kendin kaydettiğin koşu, bisiklet, kürek ve diğer kardiyo antrenmanları – zaman formatlı saf kardiyo günleri dahil. Koşularını zaten başka bir uygulama (örn. Adidas Running) yazıyorsa bunu kapalı bırak. Deltiq, diğer uygulamalardan alınan antrenmanları asla geri göndermez. Mesafe yalnızca ek „Yürüyüş + koşu mesafesi“ izniyle eklenir; izin yoksa antrenman mesafesiz kaydedilir." } }
      }
    },
    "settings.healthWrite.distanceButton": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Geh- und Laufdistanz erlauben" } },
        "en": { "stringUnit": { "state": "translated", "value": "Allow walking + running distance" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Yürüyüş + koşu mesafesine izin ver" } }
      }
    },
    "settings.healthWrite.distanceMissing": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "„Geh- und Laufdistanz“ ist nicht freigegeben – Läufe werden ohne Distanz gespeichert. Erlaube sie in der Health-App unter Profil → Apps → Deltiq." } },
        "en": { "stringUnit": { "state": "translated", "value": "“Walking + Running Distance” is not allowed – runs are saved without distance. Allow it in the Health app under Profile → Apps → Deltiq." } },
        "tr": { "stringUnit": { "state": "translated", "value": "„Yürüyüş + koşu mesafesi“ için izin yok – koşular mesafesiz kaydedilir. Health uygulamasında Profil → Uygulamalar → Deltiq altından izin ver." } }
      }
    },
    "settings.healthWrite.exportHeader": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Frühere Trainings" } },
        "en": { "stringUnit": { "state": "translated", "value": "Past workouts" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Geçmiş antrenmanlar" } }
      }
    },
    "settings.healthWrite.exportIntro": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Schreibt Trainings, die du vor dem Einschalten gespeichert hast, nachträglich nach Health. Was schon in Health steht, wird erkannt und übersprungen – du kannst den Export gefahrlos wiederholen. Aus anderen Apps importierte Einheiten werden nie zurückgeschrieben." } },
        "en": { "stringUnit": { "state": "translated", "value": "Writes workouts you saved before turning this on to Health afterwards. What is already in Health is detected and skipped – you can safely repeat the export. Workouts imported from other apps are never written back." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Bunu açmadan önce kaydettiğin antrenmanları sonradan Health'e yazar. Health'te zaten olanlar algılanıp atlanır – dışa aktarmayı güvenle tekrarlayabilirsin. Diğer uygulamalardan içe aktarılan antrenmanlar asla geri yazılmaz." } }
      }
    },
    "settings.healthWrite.exportNeedsAccess": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Erlaube zuerst oben den Zugriff." } },
        "en": { "stringUnit": { "state": "translated", "value": "Allow access above first." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Önce yukarıdan erişime izin ver." } }
      }
    },
    "settings.healthWrite.exportCheck": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Trainings prüfen" } },
        "en": { "stringUnit": { "state": "translated", "value": "Check workouts" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Antrenmanları kontrol et" } }
      }
    },
    "settings.healthWrite.resetInfo.one": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "1 Training gilt als schon an Health gesendet – auch wenn du es dort inzwischen gelöscht hast. „Neu mit Health abgleichen“ lässt Deltiq das vergessen und prüft alles neu: Was Deltiq in Health noch findet, wird nicht doppelt geschrieben, was fehlt, kannst du erneut senden." } },
        "en": { "stringUnit": { "state": "translated", "value": "1 workout counts as already sent to Health – even if you have since deleted it there. “Re-check with Health” makes Deltiq forget that and check everything again: what Deltiq still finds in Health is not written twice, and what is missing can be sent again." } },
        "tr": { "stringUnit": { "state": "translated", "value": "1 antrenman Health'e zaten gönderilmiş sayılıyor – sonradan orada silmiş olsan bile. „Health ile yeniden eşleştir“ Deltiq'in bunu unutmasını sağlar ve her şeyi yeniden kontrol eder: Deltiq'in Health'te hâlâ bulduğu kayıtlar iki kez yazılmaz, eksik olanları yeniden gönderebilirsin." } }
      }
    },
    "settings.healthWrite.resetInfo.other": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "%lld Trainings gelten als schon an Health gesendet – auch wenn du sie dort inzwischen gelöscht hast. „Neu mit Health abgleichen“ lässt Deltiq das vergessen und prüft alles neu: Was Deltiq in Health noch findet, wird nicht doppelt geschrieben, was fehlt, kannst du erneut senden." } },
        "en": { "stringUnit": { "state": "translated", "value": "%lld workouts count as already sent to Health – even if you have since deleted them there. “Re-check with Health” makes Deltiq forget that and check everything again: what Deltiq still finds in Health is not written twice, and what is missing can be sent again." } },
        "tr": { "stringUnit": { "state": "translated", "value": "%lld antrenman Health'e zaten gönderilmiş sayılıyor – sonradan orada silmiş olsan bile. „Health ile yeniden eşleştir“ Deltiq'in bunu unutmasını sağlar ve her şeyi yeniden kontrol eder: Deltiq'in Health'te hâlâ bulduğu kayıtlar iki kez yazılmaz, eksik olanları yeniden gönderebilirsin." } }
      }
    },
    "settings.healthWrite.resetButton": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Neu mit Health abgleichen" } },
        "en": { "stringUnit": { "state": "translated", "value": "Re-check with Health" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Health ile yeniden eşleştir" } }
      }
    },
    "settings.healthWrite.meta.exercises": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Übungen" } },
        "en": { "stringUnit": { "state": "translated", "value": "Exercises" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Egzersizler" } }
      }
    },
    "settings.healthWrite.meta.sets": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Sätze" } },
        "en": { "stringUnit": { "state": "translated", "value": "Sets" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Setler" } }
      }
    },
    "settings.healthWrite.meta.volume": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Volumen (kg)" } },
        "en": { "stringUnit": { "state": "translated", "value": "Volume (kg)" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Hacim (kg)" } }
