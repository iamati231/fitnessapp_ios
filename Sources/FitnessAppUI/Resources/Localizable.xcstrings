    "editor.exercise.smartOff": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus = das Gewicht wird nie automatisch geändert. Du behältst die volle Kontrolle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off = weight never auto-adjusts. You stay in full control."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı = ağırlık asla otomatik değişmez. Kontrol sende."
          }
        }
      }
    },
    "editor.exercise.smartProgressionFooterCompound": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Compound: Wenn du in allen Sätzen die obere Rep-Grenze schaffst UND im letzten Satz noch mindestens 2 Wiederholungen übrig hattest (RIR ≥ 2), steigt das Gewicht beim nächsten Mal automatisch um das eingestellte Inkrement."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compound: When you hit the upper rep limit in every set AND still had at least 2 reps in reserve in the last set (RIR ≥ 2), the weight automatically increases by your set increment next time."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bileşik: Tüm setlerde üst tekrar sınırına ulaşırsan VE son sette en az 2 tekrar daha yapabilecek durumdaysan (RIR ≥ 2), ağırlık bir sonraki sefer ayarladığın artış kadar otomatik yükselir."
          }
        }
      }
    },
    "editor.exercise.smartProgressionFooterIsolation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Isolation: Wenn du in allen Sätzen die obere Rep-Grenze schaffst UND im letzten Satz noch mindestens 1 Wiederholung übrig hattest (RIR ≥ 1), steigt das Gewicht beim nächsten Mal um das eingestellte Inkrement."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Isolation: When you hit the upper rep limit in every set AND still had at least 1 rep in reserve in the last set (RIR ≥ 1), the weight increases by your set increment next time."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzolasyon: Tüm setlerde üst tekrar sınırına ulaşırsan VE son sette en az 1 tekrar daha yapabilecek durumdaysan (RIR ≥ 1), ağırlık bir sonraki sefer ayarladığın artış kadar yükselir."
          }
        }
      }
    },
    "picker.exercise.filterFor": {
