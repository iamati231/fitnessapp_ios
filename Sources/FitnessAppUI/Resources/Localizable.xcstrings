    "baseline.family.push.cue2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brust kommt nah an den Boden, Ellbogen nicht komplett durchdrücken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chest comes close to the floor; don't lock out your elbows."
