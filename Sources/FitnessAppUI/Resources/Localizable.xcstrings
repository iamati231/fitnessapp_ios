    "baseline.result.recheckNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach 4–6 Wochen schauen wir gemeinsam, ob sich etwas verändert hat — verglichen nur mit deinem eigenen Start, nie mit anderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In 4–6 weeks we'll check together whether anything has changed — compared only to your own starting point, never to others."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "4-6 hafta sonra birlikte bir şey değişti mi diye bakacağız — sadece kendi başlangıcınla karşılaştırarak, asla başkalarıyla değil."
          }
        }
      }
    },
    "baseline.result.overall.veryLow": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du startest sinnvoll mit den einfachsten Varianten. Wir schauen in ein paar Wochen gemeinsam, ob wir steigern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're starting sensibly with the simplest variants. We'll check together in a few weeks whether to increase."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En basit varyantlarla mantıklı bir başlangıç yapıyorsun. Birkaç hafta sonra birlikte artırıp artırmayacağımıza bakarız."
          }
        }
      }
    },
    "baseline.result.overall.low": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du startest mit einem soliden, etwas reduzierten Einstieg. Das Tempo passen wir Schritt für Schritt an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're starting with a solid, slightly reduced setup. We'll adjust the pace step by step."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlam ama biraz hafifletilmiş bir başlangıç yapıyorsun. Temponu adım adım ayarlayacağız."
          }
        }
      }
    },
    "baseline.result.overall.moderate": {
