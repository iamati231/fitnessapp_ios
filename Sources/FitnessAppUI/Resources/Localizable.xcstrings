    "baseline.legs.timer.instructions": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell dich hüftbreit vor einen stabilen Stuhl, Hände leicht auf der Sitzfläche. 30 Sekunden, zähl deine sauberen Wiederholungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand shoulder-width in front of a stable chair, hands lightly on the seat. 30 seconds — count your clean reps."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlam bir sandalyenin önünde omuz genişliğinde dur, ellerini hafifçe oturma yüzeyine koy. 30 saniye — temiz tekrarlarını say."
          }
        }
      }
    },
    "baseline.legs.reps.label": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Saubere Wiederholungen in 30 Sekunden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clean reps in 30 seconds"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "30 saniyede temiz tekrar sayısı"
          }
        }
      }
    },
