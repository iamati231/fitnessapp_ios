    "settings.privacy.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export all your training and profile data as a ZIP archive of CSV files. Useful for backups, switching devices, or simply having your data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportiere alle deine Trainings- und Profildaten als ZIP-Archiv mit CSV-Dateien. Praktisch für Backups, Gerätewechsel oder einfach um deine Daten in der Hand zu haben."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm antrenman ve profil verilerini CSV dosyalarından oluşan bir ZIP arşivi olarak dışa aktar. Yedekleme, cihaz değişikliği veya verilerine sahip olmak için kullanışlıdır."
          }
        }
      }
    },
    "settings.dataExport.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data Export"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten-Export"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veri Dışa Aktarımı"
          }
        }
      }
    },
    "settings.dataExport.intro.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What this does"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was das macht"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ne yapar"
          }
        }
      }
    },
    "settings.dataExport.intro.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a ZIP archive containing every piece of data Deltiq stores about you — workouts, sets, measurements, plans, personal records and gear. All in plain CSV files that Excel, Numbers, or any spreadsheet tool can open."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt ein ZIP-Archiv mit allen Daten, die Deltiq über dich speichert — Workouts, Sätze, Körpermessungen, Pläne, persönliche Rekorde und Ausrüstung. Alles als CSV-Dateien, die Excel, Numbers oder jedes Tabellen-Tool öffnen kann."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deltiq'in seninle ilgili sakladığı her veriyi içeren bir ZIP arşivi oluşturur — antrenmanlar, setler, ölçümler, planlar, kişisel rekorlar ve ekipman. Hepsi Excel, Numbers veya herhangi bir tablo aracının açabileceği basit CSV dosyaları olarak."
          }
        }
      }
    },
    "settings.dataExport.intro.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data never leaves your device unless you share the archive yourself. The export happens entirely on this iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten verlassen dein Gerät erst, wenn du das Archiv selbst teilst. Der Export läuft vollständig auf diesem iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivi sen kendin paylaşmadıkça verilerin cihazından ayrılmaz. Dışa aktarma tamamen bu iPhone'da gerçekleşir."
          }
        }
      }
    },
