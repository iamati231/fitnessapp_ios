    "profile.envRestore.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben Original-Übungen aus einem früheren Equipment-Wechsel gespeichert. Möchtest du diese in deinen Plänen wiederherstellen (inkl. der letzten Arbeitsgewichte)?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We saved original exercises from a previous equipment change. Restore them in your plans (with the last working weights)?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki bir ekipman değişikliğinden orijinal hareketleri kaydettik. Bunları planlarına geri yüklemek ister misin (son çalışma ağırlıklarıyla)?"
          }
        }
      }
    },
