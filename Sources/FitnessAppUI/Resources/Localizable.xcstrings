    "onboarding.environment.footnote1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trainingsort filtert Plan-Empfehlungen und die Equipment-Auswahl beim Übungs-Tausch."
          }
        },
        "en": {
