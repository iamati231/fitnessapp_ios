    "picker.plan.adoptFootnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Übernehmen wird eine Tiefkopie für deine eigene Bibliothek angelegt — Tage, Übungen, Sätze sind danach frei editierbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adopting creates a deep copy in your library — days, exercises, and sets are then freely editable."
