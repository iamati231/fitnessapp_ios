    "dashboardSettings.section.active.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten + ziehen zum Umsortieren. Toggle aus, um ein Widget zu deaktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and drag to reorder. Toggle off to deactivate a widget."
          }
