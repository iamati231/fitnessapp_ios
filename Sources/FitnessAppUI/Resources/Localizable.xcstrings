    "measurement.healthkit.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Verbindung wird das aktuellste Waagen-Gewicht beim Öffnen vorausgefüllt. Beim Speichern werden Gewicht, KFA und FFM zurück nach Apple Health geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When connected, the most recent scale weight is prefilled on open. On save, weight, body fat, and FFM are written back to Apple Health."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlıyken açılışta en güncel tartı kilosu otomatik doldurulur. Kaydederken ağırlık, yağ oranı ve FFM Apple Health'e geri yazılır."
          }
        }
      }
