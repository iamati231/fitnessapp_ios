    "dashboardSettings.section.inactive.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe das '+' um ein Widget wieder ans Ende der Liste zu setzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap '+' to append a widget back to the active list."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir widget'ı tekrar aktif listenin sonuna eklemek için '+' simgesine dokun."
          }
        }
      }
    },
    "dashboardSettings.empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Widgets deaktiviert. Tippe ein '+' weiter unten, um wieder welche einzublenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All widgets are off. Tap '+' below to bring some back."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm widget'lar kapalı. Geri eklemek için aşağıdan '+' simgesine dokun."
          }
        }
      }
    },
