    "settings.dataImport.strategyPicker.appendOnlyDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only missing entries are added (plans always as new plans). Your existing workouts, records and measurements are preserved; profile and settings are taken from the archive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur fehlende Einträge werden hinzugefügt (Pläne immer als neue Pläne). Bestehende Workouts, Rekorde und Messungen bleiben erhalten; Profil und Einstellungen werden aus dem Archiv übernommen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca eksik kayıtlar eklenir (planlar her zaman yeni plan olarak). Mevcut antrenmanların, rekorların ve ölçümlerin korunur; profil ve ayarlar arşivden alınır."
          }
        }
      }
    },
    "settings.dataImport.strategyPicker.replaceWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All existing workouts, plans, measurements, gear and PRs will be deleted before the archive is restored. This cannot be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle bestehenden Workouts, Pläne, Messungen, Ausrüstung und PRs werden gelöscht, bevor das Archiv eingespielt wird. Das kann nicht rückgängig gemacht werden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşiv geri yüklenmeden önce mevcut tüm antrenmanlar, planlar, ölçümler, ekipman ve PR'lar silinir. Bu işlem geri alınamaz."
          }
        }
      }
    },
