    "baseline.core.instructions": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterarmstütz, so lange wie angenehm möglich — maximal 60 Sekunden. Brich bei Hohlkreuz oder Formverlust ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forearm plank, as long as comfortable — max 60 seconds. Stop if your lower back sags or your form breaks down."
