    "backups.unhealthy.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups angehalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups paused"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekler duraklatıldı"
          }
        }
      }
    },
    "backups.unhealthy.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App konnte ihren gewohnten Datenspeicher nicht öffnen und läuft auf einem Ersatz. Der angezeigte Stand kann veraltet sein. Es werden vorsichtshalber keine neuen Backups angelegt, damit bestehende Sicherungen nicht überschrieben werden. Bitte melde das — starte die App vorher nicht neu und lösche sie nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app couldn't open its usual data store and is running on a fallback. What you see may be out of date. No new backups are being created, so existing ones stay intact. Please report this — don't reinstall or delete the app first."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama olağan veri deposunu açamadı ve yedek bir depo üzerinde çalışıyor. Gördüğün veriler güncel olmayabilir. Mevcut yedeklerin bozulmaması için yeni yedek alınmıyor. Lütfen bunu bildir — önce uygulamayı yeniden yükleme veya silme."
          }
        }
      }
    },
    "settings.deload.toggle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deload-Vorschläge"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deload suggestions"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deload önerileri"
          }
        }
      }
    },
    "settings.deload.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deltiq erkennt Überlastung und lange Pausen und schlägt dann vor, die Arbeitsgewichte vorübergehend zu senken. Aus heißt: keine Vorschläge mehr — bereits gesenkte Gewichte bleiben, bis du sie unten zurücksetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deltiq detects overreaching and long breaks and then suggests temporarily lowering your working weights. Off means no more suggestions — weights already lowered stay until you reset them below."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deltiq aşırı yüklenmeyi ve uzun molaları algılar ve çalışma ağırlıklarını geçici olarak düşürmeyi önerir. Kapalı: artık öneri gelmez — hâlihazırda düşürülmüş ağırlıklar, aşağıdan sıfırlayana kadar öyle kalır."
          }
        }
      }
    },
    "settings.deload.endNow": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesenkte Gewichte zurücksetzen (%lld Übungen)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore lowered weights (%lld exercises)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşürülmüş ağırlıkları geri yükle (%lld egzersiz)"
          }
        }
      }
    },
    "settings.deload.endNow.done": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ursprüngliche Gewichte wiederhergestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original weights restored."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orijinal ağırlıklar geri yüklendi."
          }
        }
      }
    },
    "comeback.prompt.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen zurück"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome back"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar hoş geldin"
          }
        }
      }
    },
    "comeback.prompt.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein letztes Krafttraining war vor %lld Tagen. Soll ich die Gewichte für den Wiedereinstieg senken?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your last strength session was %lld days ago. Should I lower the weights for your return?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son kuvvet antrenmanın %lld gün önceydi. Dönüş için ağırlıkları düşürmemi ister misin?"
          }
        }
      }
    },
    "comeback.prompt.rationale": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kraft hält sich über Wochen gut — was nach einer Pause zuerst nachgibt, sind Sehnen, Technik und die Toleranz für Muskelkater. Etwas weniger Last in den ersten Sessions kostet dich nichts und schützt davor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strength holds up well over weeks — what gives first after a break is tendons, technique and your tolerance for soreness. A little less load in the first sessions costs you nothing and protects against that."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvvet haftalarca iyi korunur — molada ilk zayıflayan tendonlar, teknik ve ağrı toleransıdır. İlk seanslarda biraz daha az yük sana hiçbir şeye mal olmaz ve bundan korur."
          }
        }
      }
    },
    "comeback.prompt.amount": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduktion"
          }
        },
        "en": {
          "stringUnit": {
