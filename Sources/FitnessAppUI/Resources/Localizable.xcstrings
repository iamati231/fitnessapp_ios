    "settings.timer.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird beim Ablauf des Pausen-Timers ausgelöst. Vibrations-Toggle hat auf iPads keine Wirkung. 'PR-Feiern' steuert Save-Screen-Popups, Live-Activity-Headline und lokale Benachrichtigungen — die Bestleistungen werden trotzdem im Trophy-Room gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fires when the rest timer ends. Vibration has no effect on iPads. 'Celebrate PRs' drives save-screen popups, Live Activity headlines, and local notifications — PRs are saved to the Trophy Room either way."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mola zamanlayıcısı bittiğinde tetiklenir. Titreşim iPad'lerde etkisizdir. 'PR'ı Kutla' kaydetme ekranı pencerelerini, Live Activity başlıklarını ve yerel bildirimleri yönlendirir — PR'lar her durumda Kupa Odası'na kaydedilir."
          }
        }
      }
    },
    "settings.workout.section": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Workout-Verhalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workout Behavior"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenman Davranışı"
          }
        }
      }
    },
    "settings.workout.showWarmups": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warmup & Cooldown anzeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show warmup & cooldown"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isınma & Soğuma Göster"
          }
        }
      }
    },
    "settings.workout.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aus, werden Warmup- und Cooldown-Übungen während der Session ausgeblendet. Die Templates und deine Plan-Editierung bleiben unverändert — der Toggle wirkt nur auf den Live-Workout-Flow. Warmups sind ohnehin nie Pflicht: der „Workout speichern\"-Button bleibt immer klickbar, auch wenn du sie nicht abhakst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, warmup and cooldown exercises are hidden during the session. Templates and plan editing remain unchanged — only the live workout flow is affected. Warmups are never mandatory: 'Save Workout' stays tappable even if you skip them."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalıyken oturum sırasında ısınma ve soğuma hareketleri gizlenir. Şablonlar ve plan düzenleme değişmez — yalnızca canlı antrenman akışı etkilenir. Isınmalar zorunlu değildir: 'Antrenmanı Kaydet' onları atlasan bile aktif kalır."
          }
        }
      }
    },
    "settings.reminders.section": {
      "extractionState": "manual",
