      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast deinen Trainingsort auf %@ geändert. Sollen deine bestehenden Trainingspläne automatisch an das dort verfügbare Equipment angepasst werden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You changed your training location to %@. Should existing plans be auto-adjusted to the equipment available there?"
          }
