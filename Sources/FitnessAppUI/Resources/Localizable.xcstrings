    "onboarding.environment.footnote1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trainingsort filtert Plan-Empfehlungen und die Equipment-Auswahl beim Übungs-Tausch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Training location filters plan recommendations and equipment options when swapping exercises."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenman yeri plan önerilerini ve hareket değiştirirken ekipman seçeneklerini filtreler."
          }
        }
      }
    },
    "onboarding.environment.footnote2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hybrid- oder reine Lauf-Athleten wählen ihren Strength-Ort — die Hybrid-Pläne enthalten ihre Run-Tage unabhängig davon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hybrid or pure running athletes pick their strength location — Hybrid plans include run days regardless."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hibrit veya saf koşu sporcuları güç antrenman yerini seçer — Hibrit planlar koşu günlerini her durumda içerir."
          }
        }
      }
    },
    "onboarding.goal.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist dein primärer Fokus?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's your primary focus?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birincil odağın ne?"
          }
        }
      }
    },
    "onboarding.goal.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir kalibrieren Insights, Recovery-Hinweise und Coaching-Botschaften entsprechend."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We calibrate insights, recovery hints, and coaching messages accordingly."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öngörüleri, toparlanma ipuçlarını ve koçluk mesajlarını buna göre ayarlarız."
          }
        }
      }
    },
    "onboarding.equipment.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Womit trainierst du?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What do you train with?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi ekipmanla çalışıyorsun?"
          }
        }
      }
    },
    "onboarding.equipment.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle alles aus, was du nutzen kannst — auch Zubehör wie Bank oder Klimmzugstange. Nicht Ausgewähltes bleibt offen, bis du unten bestätigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick everything you can use — including accessories like a bench or pull-up bar. Anything unselected stays open until you confirm below."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanabileceğin her şeyi seç — bank veya barfiks demiri gibi aksesuarlar dahil. Seçilmeyenler, aşağıda onaylayana kadar açık kalır."
          }
        }
      }
    },
    "onboarding.equipment.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst diese Auswahl später jederzeit im Profil anpassen. Dein Trainingsort allein legt dein Equipment nie automatisch fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can adjust this anytime later in your profile. Your training location alone never automatically sets your equipment."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu seçimi istediğin zaman profilinden değiştirebilirsin. Antrenman yerin tek başına ekipmanını asla otomatik belirlemez."
          }
        }
      }
    },
