    "summary.early.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Der Lauf ist gespeichert, zählt aber nicht als Bestleistung — das Pensum war noch offen." } },
        "en": { "stringUnit": { "state": "translated", "value": "This run is saved but doesn't count as a personal best — the target wasn't fully reached." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Bu antrenman kaydedildi ama hedef tamamlanmadığı için rekor olarak sayılmıyor." } }
      }
    },
    "history.early.badge": {
